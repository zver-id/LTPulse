{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "RabbitMQ": "amqp://user:password@host:5672/vhost",
    "PostgreSQL": "Host=localhost;Port=5432;Database=LTPulse;Username=user;Password=password"
  },
  "ClubDetails": {
    "Url": "https://club.example.com",
    "Name": "user@domain.ru",
    "Password": "password"
  },
  "Mattermost": {
    "Url": "https://mattermost.example.com/api/v4/",
    "Token": "your-personal-access-token",
    "TeamUrl": "https://mattermost.example.com/team-slug"
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "internalLogLevel": "Trace",
    "internalLogFile": "${basedir}/internal-nlog.txt",
    "extensions": [
      { "assembly": "NLog.Extensions.Logging" }
    ],
    "targets": {
      "jsonFile": {
        "type": "File",
        "fileName": "${basedir}/logs/TechKasConnector_${shortdate}.log",
        "layout": {
          "type": "JsonLayout",
          "attributes": [
            { "name": "time", "layout": "${longdate}" },
            { "name": "level", "layout": "${level}" },
            { "name": "message", "layout": "${message}" },
            { "name": "lg", "layout": "${logger}" },
            { "name": "ex", "layout": "${exception:format=ToString}" },
            { "name": "machineName", "layout": "${machinename}" },
            { "name": "pid", "layout": "${processid}" },
            { "name": "threadId", "layout": "${threadid}" }
          ]
        },
        "archiveEvery": "Day",
        "maxArchiveFiles": 7
      },
      "logconsole": {
        "type": "Console",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}"
      }
    },
    "rules": [
      { "logger": "*", "minLevel": "Trace", "writeTo": "jsonFile" },
      { "logger": "*", "minLevel": "Info", "writeTo": "logconsole" }
    ]
  }
}
